OPENAI_API_KEY=
# Fallback model, used for either step if its specific env var below is unset.
OPENAI_MODEL=gpt-5.4
# Extraction has no grounding/web_search requirement, so a cheaper model is fine here.
OPENAI_EXTRACTION_MODEL=
# Verification must use a model that supports the Responses API's built-in
# web_search tool (see CLAUDE.md) — check OpenAI's current model/pricing docs
# before picking one.
OPENAI_VERIFICATION_MODEL=

# Only needed for `npm run eval:verification -- --provider mistral` or
# `--compare` (see CLAUDE.md) — dev-time comparison only, not used by the app.
MISTRAL_API_KEY=
# Must support the Conversations API's built-in web_search tool. Defaults to
# mistral-medium-latest if unset.
MISTRAL_VERIFICATION_MODEL=
